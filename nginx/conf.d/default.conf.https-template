# PHASE 2 (final) — copy this file's contents into default.conf once the
# first certificate has been obtained (see ../README.md). Redirects plain
# HTTP to HTTPS, and terminates TLS here before forwarding to the API.
server {
    listen 80;
    listen [::]:80;
    server_name api.yamin.yourdomain.com;

    # Kept even after HTTPS is live — this is also how certbot's renewals
    # (which happen over plain HTTP) keep working.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.yamin.yourdomain.com;

    ssl_certificate     /etc/letsencrypt/live/api.yamin.yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.yamin.yourdomain.com/privkey.pem;

    location / {
        proxy_pass http://backend-api:3000;
        proxy_http_version 1.1;
        # Required for socket.io/WebSocket connections — see the note in
        # default.conf for why these two headers matter.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
