PORT=3000


NODE_ENV=development
APP_PORT=3000
APP_NAME="openAI Embedding"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
# Used to resolve a spoken reminder time ("remind me at 2:43") when the client
# doesn't send its own device timezone. Set to this app's actual market.
DEFAULT_TIMEZONE=Asia/Beirut
FRONTEND_DOMAIN=https://www.travlo.co
BACKEND_DOMAIN=http://localhost:3000

SHOW_ERROR_DETAILS=true

# Support "local", "s3", "s3-presigned"
# FILE_DRIVER=s3
# ACCESS_KEY_ID=
# SECRET_ACCESS_KEY=
# AWS_S3_REGION=eu-west-3
# AWS_DEFAULT_S3_BUCKET=
# AWS_DEFAULT_S3_URL=


AUTH_JWT_SECRET=change-me
AUTH_JWT_TOKEN_EXPIRES_IN=72h
AUTH_REFRESH_SECRET=change-me
AUTH_REFRESH_TOKEN_EXPIRES_IN=365d
AUTH_FORGOT_SECRET=change-me
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=change-me
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=2d


DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me
DATABASE_NAME=yamin_db
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=
GOOGLE_MAPS_API_KEY=


REDIS_HOST=localhost
REDIS_PORT=6379
# NOTE: no inline comments on value lines — Docker/dotenv parsers disagree on
# them, and the comment text can silently become part of the value.
REDIS_PASSWORD=change-me

# --- AWS S3 Bucket Configuration ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=yamin-bucket1
# Optional (only if using a custom endpoint like Cloudflare R2).
# This comment used to sit inline after the `=`, and the parser passed it
# through as the literal endpoint value — every presign call 500'd with
# ERR_INVALID_URL. Keep comments on their own lines.
AWS_S3_ENDPOINT=

# --- Frontend web build ---
# Inlined into the web bundle at BUILD time (not read at runtime), so changing
# it requires `docker compose build frontend`. Leave blank to use the app's
# default of http://localhost:3000, which is correct for a browser on this
# machine but useless from a phone — there "localhost" is the phone itself.
# Set to this host's LAN address to test on a real device; if the Wi-Fi address
# changes (DHCP), update it here and rebuild.
EXPO_PUBLIC_API_URL=http://192.168.10.61:3000

# --- AI Providers (OpenRouter via Vercel AI SDK) ---
# 'openrouter' = real calls. 'mock' = deterministic offline stubs; must be set
# EXPLICITLY and is refused when NODE_ENV=production. A missing key no longer
# silently degrades to mock — the app fails to boot instead.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Natively 1536-dim; matches the vector(1536) column exactly. ~$0.02/1M tokens.
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
# Speech-to-text. A multimodal chat model is used here rather than Whisper
# because it can be INSTRUCTED, and this app's speakers mix Lebanese Arabic,
# English and French inside one sentence. Whisper takes a single language code,
# which cannot describe "hi kifak, ça va?" — it picks one language and mangles
# or translates the rest, which is why an English note came back in Arabic.
# Set to openai/whisper-1 to switch back to the classic path.
AI_STT_MODEL=google/gemini-2.5-flash
# Only read on the Whisper path. Blank = let Whisper guess. Pinning (e.g. 'en',
# 'ar', 'fr') helps a single-language speaker and hurts a trilingual one.
AI_STT_LANGUAGE=
AI_EXTRACTION_MODEL=google/gemini-2.5-flash
