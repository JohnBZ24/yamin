PORT=3000


NODE_ENV=production
APP_PORT=3000
APP_NAME="openAI Embedding"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
DEFAULT_TIMEZONE=Asia/Beirut
# Real HTTPS domain the API is reachable at, used by the app itself (nginx's
# domain is set by running nginx/setup.sh <domain> on the server — see
# nginx/README.md).
BACKEND_DOMAIN=https://yamin.yourdomain.com

# false in production: true echoes internal error messages/stack traces back
# to API callers, which is useful locally and a real information leak once
# this is reachable from the internet.
SHOW_ERROR_DETAILS=false

# Support "local", "s3", "s3-presigned"
# FILE_DRIVER=s3
# ACCESS_KEY_ID=
# SECRET_ACCESS_KEY=
# AWS_S3_REGION=eu-west-3
# AWS_DEFAULT_S3_BUCKET=
# AWS_DEFAULT_S3_URL=


# Generate real random values for all AUTH_*_SECRET keys below, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do not reuse the dev placeholders ("secret", "secret_for_refresh", ...).
AUTH_JWT_SECRET=
AUTH_JWT_TOKEN_EXPIRES_IN=72h
AUTH_REFRESH_SECRET=
AUTH_REFRESH_TOKEN_EXPIRES_IN=365d
AUTH_FORGOT_SECRET=
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=2d


DATABASE_TYPE=postgres
# DATABASE_HOST / DATABASE_PORT are overridden by docker-compose.yml itself
# (set to the "postgres" service) — whatever is here is only a fallback.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
# A real, unique password — this also becomes the Postgres container's own
# superuser password on first boot.
DATABASE_PASSWORD=
DATABASE_NAME=yamin_db
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=
GOOGLE_MAPS_API_KEY=


REDIS_HOST=redis
REDIS_PORT=6379
# A real, unique password — also becomes the Redis container's own auth
# password on first boot (see docker-compose.yml's `--requirepass`).
REDIS_PASSWORD=

# --- AWS S3 Bucket Configuration ---
# Use FRESH keys here — rotate the AWS access key in IAM before deploying.
# The previous key was exposed in plaintext during a local debugging session
# and must be treated as compromised even though it was never committed to git.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=yamin-bucket1
AWS_S3_ENDPOINT=

# --- Frontend web build ---
# Baked into the web bundle at build time. LEAVE EMPTY in production: nginx
# serves the web app and the API from the same origin, and an empty value
# makes the web app talk to its own origin (see frontend/src/lib/api.ts).
EXPO_PUBLIC_API_URL=

# --- AI Providers (OpenRouter via Vercel AI SDK) ---
AI_PROVIDER=openrouter
# Fresh key — same rotation note as AWS above; the previous key was exposed
# in plaintext and must be treated as compromised.
OPENROUTER_API_KEY=

AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_STT_MODEL=google/gemini-2.5-flash
AI_STT_LANGUAGE=
AI_EXTRACTION_MODEL=google/gemini-2.5-flash
# Graph extraction, reminder parsing, and question answering — the calls that
# need to actually understand context. Falls back to AI_EXTRACTION_MODEL if
# unset, but a stronger model here is what makes pronouns ("he has an
# operation") and follow-up questions resolve correctly.
AI_SMART_MODEL=anthropic/claude-sonnet-5

# --- CORS (see backend/src/utils/cors.ts) ---
# Required non-empty in production or the API refuses to boot. This must be
# the origin the PAGE is served from (the site itself, since nginx serves app
# and API from one origin), not the API's own address. Native mobile requests
# carry no Origin header and bypass this entirely. Comma-separate multiple.
CORS_ORIGINS=https://yamin.yourdomain.com
