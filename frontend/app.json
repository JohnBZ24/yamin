{
  "expo": {
    "name": "Yamin",
    "slug": "baroud",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yamin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.yamin.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Yamin records your voice notes so it can remember what you tell it."
      }
    },
    "android": {
      "package": "com.yamin.app",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#111111",
          "defaultChannel": "reminders"
        }
      ],
      "expo-secure-store",
      "expo-asset",
      [
        "expo-calendar",
        {
          "calendarPermission": "Yamin adds the reminders you ask for to your calendar, so they show up alongside everything else you have on."
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Inter_500Medium.ttf",
            "./assets/fonts/Sora_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "NextReminder",
              "label": "Yamin — Next reminder",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "200dp",
              "resizeMode": "horizontal|vertical",
              "description": "What Yamin is about to remind you about",
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8d468592-967e-49b4-9f7f-c9dc6514af9b"
      }
    },
    "owner": "stephane234s-team"
  }
}
